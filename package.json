{
  "name": "clinic-workforce",
  "version": "0.1.0",
  "private": true,
  "description": "Workforce and HR platform for healthcare clinics",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/schedule-demo",
    "apps/staff-demo"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "demo:build": "node apps/schedule-demo/build.mjs && node apps/staff-demo/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "drizzle-orm": "^0.44.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
