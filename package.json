{
  "name": "clinic-workforce",
  "version": "0.1.0",
  "private": true,
  "description": "Workforce and HR platform for healthcare clinics",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/schedule-demo",
    "apps/staff-demo"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "demo:build": "node apps/schedule-demo/build.mjs && node apps/staff-demo/build.mjs",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "embedded-postgres": "^18.6.0-beta.19",
    "esbuild": "^0.25.12",
    "pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
